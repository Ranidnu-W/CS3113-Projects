{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run (make run in current project)",
            "type": "shell",
            "command": "./run.sh run \"${file}\"",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Build (make in current project)",
            "type": "shell",
            "command": "./run.sh build \"${file}\"",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Clean (make clean in current project)",
            "type": "shell",
            "command": "./run.sh clean \"${file}\"",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
